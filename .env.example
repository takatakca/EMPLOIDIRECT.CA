# Launch: cp .env.example .env (Node 22: node --env-file=.env server/index.js)
NODE_ENV=development
PORT=3001
DATA_DIR=.data
# Required in production to enforce the canonical HTTPS origin on browser writes.
APP_ORIGIN=https://emploidirect.ca
# When behind an HTTPS reverse proxy, enable trust proxy only if your proxy is trusted.
TRUST_PROXY=false

# Production: persistent PostgreSQL storage (do not commit credentials).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full
# DATABASE_SSL_CA_FILE=/secure/path/ca.crt
